<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>win-tendedero</AssemblyName>
    <RootNamespace>WinTendedero</RootNamespace>
    <StartupObject>WinTendedero.Program</StartupObject>
    <ApplicationIcon>Assets\win-tendedero.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.6.3</Version>
    <InformationalVersion>1.6.3-cn.1</InformationalVersion>
    <Product>win-tendedero</Product>
    <Authors>beiming183-cloud</Authors>
    <Description>win-tendedero - Windows screenshot clothesline, Simplified Chinese edition.</Description>
    <Copyright>MIT License</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\win-tendedero.ico" />
    <Resource Include="Assets\Mark.png" />
    <Resource Include="Assets\Fonts\Manrope-ExtraBold.ttf" />
  </ItemGroup>

</Project>
